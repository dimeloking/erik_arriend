{
  "name": "next-js-boilerplate",
  "author": "Ixartz (https://github.com/ixartz)",
  "type": "module",
  "scripts": {
    "dev:spotlight": "npx @spotlightjs/spotlight",
    "dev:next": "next dev",
    "dev": "run-p db-server:file dev:*",
    "build:next": "next build",
    "build-local": "run-p db-server:memory build:next --race",
    "build": "run-s db:migrate build:next",
    "start": "next start",
    "build-stats": "cross-env ANALYZE=true npm run build",
    "clean": "rimraf .next out coverage",
    "lint": "ultracite check src tests .storybook checkly.config.ts commitlint.config.ts drizzle.config.ts knip.config.ts next.config.ts oxlint.config.ts oxfmt.config.ts playwright.config.ts vitest.config.ts package.json tsconfig.json --type-aware --type-check",
    "lint:fix": "ultracite fix src tests .storybook checkly.config.ts commitlint.config.ts drizzle.config.ts knip.config.ts next.config.ts oxlint.config.ts oxfmt.config.ts playwright.config.ts vitest.config.ts package.json tsconfig.json --type-aware --type-check",
    "check:types": "tsc --noEmit --pretty",
    "check:deps": "knip",
    "check:i18n": "i18n-check -l src/locales -s en -u src -f next-intl",
    "commit": "commit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db-server:file": "pglite-server -m 100 --db=local.db --run \"cmd /c npm run db:migrate\"",
    "db-server:memory": "pglite-server -m 100 --run \"cmd /c npm run db:migrate\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "dotenv -c -- drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "storybook": "storybook dev -p 6006",
    "storybook:test": "vitest run --config .storybook/vitest.config.mts",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@arcjet/next": "^1.13.0",
    "@babylonjs/core": "^9.28.0",
    "@clerk/localizations": "^4.20.0",
    "@clerk/nextjs": "^7.5.1",
    "@electric-sql/pglite": "^0.5.8",
    "@logtape/logtape": "^2.3.9",
    "@sentry/nextjs": "^10.57.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "drizzle-orm": "^0.45.3",
    "next": "^16.3.6",
    "next-intl": "^4.13.0",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/prompt-cli": "^21.2.3",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@lingual/i18n-check": "^0.9.5",
    "@next/bundle-analyzer": "^16.3.6",
    "@playwright/test": "^1.63.0",
    "@spotlightjs/spotlight": "^4.11.8",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/nextjs-vite": "^10.6.0",
    "@swc/helpers": "^0.5.23",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "babel-plugin-react-compiler": "^1.0.0",
    "checkly": "^9.5.0",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.11",
    "knip": "^6.38.0",
    "lefthook": "^2.1.14",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.69.0",
    "oxlint-tsgolint": "^0.23.0",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.9",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "ultracite": "^7.8.3",
    "vitest": "4.1.11",
    "vitest-browser-react": "^2.3.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.28.0"
    },
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/mocker": "4.1.11",
    "postcss": "8.5.28",
    "vitest": "4.1.11"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits"
        }
      ],
      "@semantic-release/release-notes-generator",
      "@semantic-release/github"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "postcss": {
    "plugins": {
      "@tailwindcss/postcss": {}
    }
  }
}
